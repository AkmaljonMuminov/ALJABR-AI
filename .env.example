# ALJABR AI configuration template.
# Copy to .env and edit:   cp .env.example .env
# NEVER commit .env - it is listed in .gitignore.

# development | production | test
ALJABR_ENV=development

# User-facing language: uz | ru | en
ALJABR_LANGUAGE=uz

# Wake phrase (used by the voice system from Phase 3)
ALJABR_WAKE_PHRASE=Salom, ALJABR

# DEBUG | INFO | WARNING | ERROR | CRITICAL
ALJABR_LOG_LEVEL=INFO

# Relative paths are resolved from the project folder.
ALJABR_DATA_DIR=data
# Defaults to <data dir>/logs when empty
ALJABR_LOG_DIR=

# --- AI provider (ALJABR BRAIN) -------------------------------------------
# Provider name. Currently supported: openai (any OpenAI-compatible server works).
ALJABR_AI_PROVIDER=openai
# Set the model name you want to use; intentionally not hardcoded.
ALJABR_AI_MODEL=
# Paste your key in your local .env only. Leave empty here.
OPENAI_API_KEY=
# API address. Must be https:// (http:// is allowed only for localhost).
ALJABR_AI_BASE_URL=https://api.openai.com/v1
# Seconds to wait for the AI service (5-120)
ALJABR_AI_TIMEOUT=30
# How many recent messages are kept as conversation context (2-200)
ALJABR_AI_MAX_HISTORY=20

# --- Voice (ALJABR VOICE) --------------------------------------------------
# auto = use Termux:API if installed, otherwise text mode | termux | console
ALJABR_VOICE_BACKEND=auto
# Speech output language/region/engine (passed to termux-tts-speak). Leave
# region and engine empty to use the phone defaults.
ALJABR_TTS_LANGUAGE=uz
ALJABR_TTS_REGION=
ALJABR_TTS_ENGINE=
# Pitch 0.5-2.0 (above 1.0 sounds higher, approximating a female voice) and
# speed 0.5-2.0. The result depends on the phone's TTS engine - tune on device.
ALJABR_TTS_PITCH=1.1
ALJABR_TTS_RATE=0.95
# Seconds to wait for speech input (5-60)
ALJABR_STT_TIMEOUT=20
# true = only react to speech that starts with the wake phrase above
ALJABR_VOICE_REQUIRE_WAKE=false
